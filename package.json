{
  "name": "orangehrm-admin-user-cucumber",
  "version": "1.0.0",
  "private": true,
  "description": "A single Playwright and Cucumber scenario for creating an OrangeHRM user",
  "scripts": {
    "test": "cucumber-js features",
    "test:feature": "cucumber-js features/admin-user-management.feature",
    "test:allure": "npm test && npm run report:generate",
    "report:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:open": "allure open ./allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.14.0",
    "dotenv": "^18.0.8",
    "playwright": "^1.64.1"
  }
}
